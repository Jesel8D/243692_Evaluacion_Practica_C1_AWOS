# .env.example

# Configuración del contenedor de Base de Datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_password_aqui
POSTGRES_DB=nombre_db

# Cadena de conexión de Next.js
# Nota: Si se corre Next.js localmente, se tiene que usar localhost:5433
# Si se corre Next.js en Docker, se tine que usar db:5432
DATABASE_URL="postgresql://app_user:app_password_123@localhost:5433/nombre_db"